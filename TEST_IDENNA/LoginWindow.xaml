<Window x:Class="TEST_IDENNA.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:TEST_IDENNA.ViewModels" xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        Title="Ingreso al Sistema - IDENNA" Height="600" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource FondoPrincipal}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/fondo_login.jpg" 
                        Stretch="UniformToFill" 
                        AlignmentX="Center" 
                        AlignmentY="Center" 
                        Opacity="1"/>
        </Grid.Background>

        <Border CornerRadius="12" Background="Transparent" Margin="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <!--<materialDesign:PackIcon Kind="ShieldLock" Width="48" Height="48" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>-->
                    <Image Source="\Resources\logo_idenna.png" Width="140" Height="60" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="CONTROL DE ACCESO" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="De Gestión y Seguimiento Administrativo de IDENNA" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Nombre de Usuario"
                             BorderBrush="White"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,20" Foreground="White">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding IniciarSesionCommand}" CommandParameter="{Binding ElementName=TxtPassword}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="TxtPassword" 
                            materialDesign:HintAssist.Hint="Contraseña"
                            BorderBrush="White"
                            Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                            Foreground="White"
                            Visibility="Visible">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding IniciarSesionCommand}" CommandParameter="{Binding ElementName=TxtPassword}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>

                        <TextBox x:Name="TxtPasswordVisible"
                            materialDesign:HintAssist.Hint="Contraseña"
                            BorderBrush="White"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Foreground="White"
                            Visibility="Collapsed"
                            TextChanged="TxtPasswordVisible_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding IniciarSesionCommand}" CommandParameter="{Binding ElementName=TxtPassword}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <ToggleButton Grid.Column="1"
                            Style="{StaticResource MaterialDesignActionToggleButton}"
                            ToolTip="Mostrar/Ocultar contraseña"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Foreground="White"
                            Margin="10,0,0,0"
                            Checked="BtnOjo_Checked"
                            Unchecked="BtnOjo_Unchecked">
                            <materialDesign:PackIcon Kind="EyeOutline" />
                        </ToggleButton>
                    </Grid>

                    <TextBlock Text="{Binding MensajeError}" Foreground="#ef4444" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,20,0,30">
                    <Button Command="{Binding IniciarSesionCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Content="INICIAR SESIÓN" BorderBrush="Transparent" Background="DarkRed" Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="20" Height="45"/>

                    <Button Command="{Binding SalirCommand}" 
                        Content="Salir del Programa" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,10,0,0"  Foreground="White" materialDesign:ButtonAssist.CornerRadius="20" Height="45"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>