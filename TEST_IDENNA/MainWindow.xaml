<Window x:Class="TEST_IDENNA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:System;assembly=mscorlib"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels"
        xmlns:views="clr-namespace:TEST_IDENNA.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:TEST_IDENNA.Helpers"
        xmlns:local="clr-namespace:TEST_IDENNA" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Registro IDENNA" Height="648" Width="1152">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme />
                
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
            </Style>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpedientesViewModel}">
                <views:ExpedientesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegistroBeneficiarioViewModel}">
                <views:RegistrarBeneficiarioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BitacoraViewModel}">
                <views:BitacoraView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
                <views:ReportesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditoriasViewModel}">
                <views:AuditoriasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GestionTutoresViewModel}">
                <views:GestionTutoresView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DigitalizarDocumentosViewModel}">
                <views:DigitalizarDocumentosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PapeleraViewModel}">
                <views:PapeleraView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
                <views:UsuariosView />
            </DataTemplate>

            <Style x:Key="SidebarButtonStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="MainBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="0"
                                    Margin="0,2">
                                <Grid>
                                    <Rectangle x:Name="SelectionIndicator" 
                                               HorizontalAlignment="Left" 
                                               Fill="{DynamicResource ColorAccent}" 
                                               Width="4" 
                                               Visibility="Collapsed"/>

                                    <StackPanel Orientation="Horizontal" Margin="15,5">
                                        <ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                         VerticalAlignment="Center"/>
                                        <ContentPresenter ContentSource="Content" 
                                                         Margin="15,0,0,0"
                                                         VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource SidebarSelected}"/>
                                    <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource FondoPrincipal}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource FondoSidebar}" BorderBrush="{DynamicResource ColorComponentes}" BorderThickness="0,0,1,0">
            <Grid Margin="10,40,10,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Image Source="\Resources\logo_idenna.png" Width="100" Height="50" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <ListBox Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="HouseOutline" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>Dashboard</ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowDashboardCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>Expedientes Digitales</ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowExpedientesCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Bitácora de Actividades (Personal)" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowBitacoraCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="TrendingUp" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Reportes Estadísticos" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowReportesCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="ListBox" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Gestion de Tutores" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowGestionTutoresCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="FileAccountOutline" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Digitalizar Documentos" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowDigitalizarDocumentosCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="Trash" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Papelera" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowPapeleraCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}" Visibility="{Binding PermisoAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="Lock" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Auditorias y Seguridad" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowAuditoriasCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource SidebarButtonStyle}" Visibility="{Binding PermisoAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBoxItem.Tag>
                                <materialDesign:PackIcon Kind="UserBoxes" Width="18" Height="18"/>
                            </ListBoxItem.Tag>
                            <ListBoxItem.Content>
                                <TextBlock Text="Gestion de Usuarios" TextWrapping="Wrap" MaxWidth="150" />
                            </ListBoxItem.Content>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding ShowUsuariosCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="5,10,5,0">

                    <Border BorderBrush="{DynamicResource ColorComponentes}" 
                        BorderThickness="0,1,0,0" 
                        Margin="5,0,5,15" 
                        Opacity="0.4"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="WbSunny" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16"/>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                              Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="MoonWaningCrescent" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16"/>
                    </StackPanel>

                    <Grid Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <materialDesign:PackIcon Kind="AccountCircleOutline" 
                                 Grid.Column="0" 
                                 Width="36" Height="36" 
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                 VerticalAlignment="Center" 
                                 Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsuarioLogueadoNombre, FallbackValue='Cargando...'}" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextoPrincipal}" 
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/> 

                            <TextBlock Text="{Binding UsuarioLogueadoRol, FallbackValue='Especialista'}" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextoSecundario}"
                                   Margin="0,2,0,0"
                                   FontWeight="Normal"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="20"/>

        <Grid x:Name="LoadingOverlay" 
              Background="#80000000" 
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card UniformCornerRadius="15" 
                                 Padding="20" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center"
                                 Background="{DynamicResource FondoSidebar}"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" 
                                 IsIndeterminate="True" 
                                 Width="50" Height="50" 
                                 Foreground="{DynamicResource ColorAccent}"/>
                    <TextBlock Text="Cargando datos..." 
                               Margin="0,15,0,0" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextoPrincipal}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>