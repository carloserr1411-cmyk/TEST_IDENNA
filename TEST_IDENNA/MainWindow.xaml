<Window x:Class="TEST_IDENNA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels"
        xmlns:views="clr-namespace:TEST_IDENNA.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TEST_IDENNA" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Registro IDENNA" Height="480" Width="850">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <!-- More setters... -->
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExpedientesViewModel}">
            <views:ExpedientesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegistroBeneficiarioViewModel}">
            <views:RegistrarBeneficiarioView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BitacoraViewModel}">
            <views:BitacoraView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
            <views:ReportesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ArchivosViewModel}">
            <views:ArchivosView/>
        </DataTemplate>

        <Style x:Key="SidebarButtonStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="MainBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="0"
                        Margin="0,2">
                            <Grid>
                                <Rectangle x:Name="SelectionIndicator" 
                                   HorizontalAlignment="Left" 
                                   Fill="#1A237E" 
                                   Width="4" 
                                   Visibility="Collapsed"/>

                                <StackPanel Orientation="Horizontal" Margin="15,5">
                                    <ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                              VerticalAlignment="Center"/>

                                    <ContentPresenter ContentSource="Content" 
                                              Margin="15,0,0,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#F0F2F5"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#EBEDF0"/>
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#1A237E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Nombre del Niño/Adolescente:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
            <Button Content="Guardar en Base de Datos" 
                    Command="{Binding RegistrarCommand}" 
                    Padding="10,5"/>
            </StackPanel> -->
