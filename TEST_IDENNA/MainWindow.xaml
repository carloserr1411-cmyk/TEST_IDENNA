            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
                <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,10,0"/>
                <Button Content="Registrar Niño/a" Command="{Binding RegistrarCommand}" Background="#2196F3" Foreground="White" Padding="10,0"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding ListaNinos}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding Nombres}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF">
            <StackPanel Margin="10,40,10,10">
                <TextBlock Text="SGI IDENNA" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!--<Button Content="Dashboard" Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowDashboardCommand}"/>
                        <Button Content="Expedientes" Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowExpedientes}"/>
                        <Button Content="Actividades" Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowActividadesCommand}"/>-->

                <ListBox Background="White" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarButtonStyle}">
                    <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem.Tag>
                            <materialDesign:PackIcon Kind="HouseOutline" Width="18" Height="18"/>
                        </ListBoxItem.Tag>
                        <ListBoxItem.Content>
                            Dashboard
                        </ListBoxItem.Content>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Selected">
                                <b:InvokeCommandAction Command="{Binding ShowDashboard}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBoxItem>
                    
                    <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem.Tag>
                            <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18"/>
                        </ListBoxItem.Tag>
                        <ListBoxItem.Content>
                            Expedientes Digitales
                        </ListBoxItem.Content>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Selected">
                                <b:InvokeCommandAction Command="{Binding ShowExpedientes}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem.Tag>
                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18"/>
                        </ListBoxItem.Tag>
                        <ListBoxItem.Content>
                            <!--Bitácora de Actividades (Personal)-->
                            <TextBlock Text="Bitácora de Actividades (Personal)" 
                                       TextWrapping="Wrap" 
                                       MaxWidth="150" />    
                        </ListBoxItem.Content>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Selected">
                                <b:InvokeCommandAction Command="{Binding ShowBitacora}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem.Tag>
                            <materialDesign:PackIcon Kind="TrendingUp" Width="18" Height="18"/>
                        </ListBoxItem.Tag>
                        <ListBoxItem.Content>
                            <!--Reportes Estadísticos-->
                            <TextBlock Text="Reportes Estadísticos" 
                                       TextWrapping="Wrap" 
                                       MaxWidth="150" />
                        </ListBoxItem.Content>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Selected">
                                <b:InvokeCommandAction Command="{Binding ShowReportes}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarButtonStyle}">
                        <ListBoxItem.Tag>
                            <materialDesign:PackIcon Kind="History" Width="18" Height="18"/>
                        </ListBoxItem.Tag>
                        <ListBoxItem.Content>
                            <!--Archivo Histórico-->
                            <TextBlock Text="Archivo Histórico" 
                                       TextWrapping="Wrap" 
                                       MaxWidth="150" />
                        </ListBoxItem.Content>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Selected">
                                <b:InvokeCommandAction Command="{Binding ShowArchivoHistorico}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="20"/>
        </Grid>
</Window>
