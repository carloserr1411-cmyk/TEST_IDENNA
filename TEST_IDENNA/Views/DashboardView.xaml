<UserControl x:Class="TEST_IDENNA.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:viewmodels="clr-namespace:TEST_IDENNA.ViewModels" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource FondoPrincipal}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarDatosDashboardCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Panel de Control General" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}"/>
            <TextBlock Text="Resumen operativo del sistema de expedientes" FontSize="13" Foreground="{DynamicResource TextoSecundario}" Margin="0,4,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">

            <Border Background="{DynamicResource FondoTarjetas}" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Total Expedientes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextoSecundario}"/>
                        <TextBlock Text="{Binding TotalExpedientes, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <materialDesign:PackIcon Kind="FolderMultipleOutline" Foreground="#3498DB" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource FondoTarjetas}" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Atenciones de Hoy" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextoSecundario}"/>
                        <TextBlock Text="{Binding AtencionesHoy, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Foreground="#2ECC71" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource FondoTarjetas}" CornerRadius="20" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Alertas Pendientes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextoSecundario}"/>
                            <TextBlock Text="{Binding AlertasPendientes, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="#E74C3C" Margin="0,2,0,0"/>
                        </StackPanel>
                        <materialDesign:PackIcon Kind="AlertOctagonOutline" Foreground="#E74C3C" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource ColorComponentes}" BorderThickness="0,1,0,0" Margin="0,10,0,8" Opacity="0.4"/>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="PhoneOffOutline" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Sin teléfono" FontSize="12" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center"/>
                            <materialDesign:Badged Grid.Column="2" Content="{Binding AlertasSinTelefono, FallbackValue='0'}" BadgeBackground="#E74C3C" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountAlertOutline" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Sin representante" FontSize="12" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center"/>
                            <materialDesign:Badged Grid.Column="2" Content="{Binding AlertasSinNombre, FallbackValue='0'}" BadgeBackground="#E74C3C" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="BoxLocation" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Sin ubicacion de archivos registrada" FontSize="12" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center"/>
                            <materialDesign:Badged Grid.Column="2" Content="{Binding AlertasSinUbicacion, FallbackValue='0'}" BadgeBackground="#E74C3C" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource FondoTarjetas}" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Expedientes Modificados Recientemente" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,0,0,15"/>

                    <ListBox ItemsSource="{Binding UltimosExpedientes}" Background="Transparent" HorizontalContentAlignment="Stretch" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AccountCircleOutline" Foreground="{DynamicResource TextoSecundario}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NombreCompleto}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}" FontSize="13"/>
                                        <TextBlock Text="{Binding IdentificadorExpediente}" FontSize="11" Foreground="{DynamicResource TextoSecundario}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FechaModificacion, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Margin="40,0,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource FondoTarjetas}" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Estado General de Medidas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Casos en Seguimiento Inicial" FontSize="12" Foreground="{DynamicResource TextoPrincipal}"/>
                                <TextBlock Text="{Binding PorcentajeSeguimiento, StringFormat='{}{0}%', FallbackValue='0%'}" 
                                           HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}"/>
                            </Grid>
                            <ProgressBar Value="{Binding PorcentajeSeguimiento, FallbackValue=0}" 
                                         Height="8" Margin="0,6,0,0" Foreground="#3498DB" 
                                         Background="{DynamicResource FondoTrackProgressBar}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Casos Concluidos/Evolucionados" FontSize="12" Foreground="{DynamicResource TextoPrincipal}"/>
                                <TextBlock Text="{Binding PorcentajeConcluidos, StringFormat='{}{0}%', FallbackValue='0%'}" 
                                           HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}"/>
                            </Grid>
                            <ProgressBar Value="{Binding PorcentajeConcluidos, FallbackValue=0}" 
                                         Height="8" Margin="0,6,0,0" Foreground="#2ECC71" 
                                         Background="{DynamicResource FondoTrackProgressBar}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource ColorComponentes}" Margin="0,15"/>

                    <TextBlock Text="Tip: Recuerda revisar diariamente la sección de alertas para rellenar la informacion importante de los beneficiarios." 
                               FontSize="11" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>