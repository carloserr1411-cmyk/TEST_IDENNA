<Window x:Class="TEST_IDENNA.Views.Dialogs.ExitoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Width="350" Height="200" 
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Background="#d9d9d9" CornerRadius="15" BorderThickness="1" BorderBrush="#E0E0E0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="CheckCircle" 
                                    Foreground="#4CAF50" 
                                    Width="60" Height="60" 
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtMensaje" 
                       Grid.Row="1"
                       Text="Operación exitosa" 
                       FontSize="16" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center" 
                       VerticalAlignment="Center"
                       Foreground="#333333"/>

            <Button Grid.Row="2" 
        Content="ACEPTAR"
        Click="Aceptar_Click"
        Style="{StaticResource MaterialDesignRaisedButton}" 
        Background="#325b8a"
        BorderBrush="#325b8a"
        materialDesign:ButtonAssist.CornerRadius="20"
        Width="120"/>
        </Grid>
    </Border>
</Window>