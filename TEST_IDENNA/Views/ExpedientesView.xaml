<UserControl x:Class="TEST_IDENNA.Views.ExpedientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TEST_IDENNA.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:s="clr-namespace:TEST_IDENNA.Services"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ExpedientesViewModel}">

    <UserControl.Resources>
        <s:IntToBooleanConverter x:Key="IntToBooleanConverter"/>
        <s:BytesToImageConverter x:Key="BytesToImageConverter"/>
        <Style x:Key="SeccionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="TimelineItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

        <!-- 1. Envolvemos todo en el DialogHost -->
    <materialDesign:DialogHost IsOpen="{Binding IsEvolucionDialogOpen}" Identifier="AgregarEvolucionDialog">

            <!-- 2. Definimos qué se verá DENTRO del diálogo (El Formulario) -->
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="20" Width="400">
                    <TextBlock Text="Nueva Actualización" Style="{StaticResource SeccionHeaderStyle}" Margin="0,0,0,20"/>

                    <!-- Selector de Actividad (Catálogo) -->
                    <ComboBox ItemsSource="{Binding ActividadesDisponibles}"
                          SelectedItem="{Binding ActividadSeleccionada}"
                          DisplayMemberPath="Tipo_Actividad"
                          materialDesign:HintAssist.Hint="Seleccione la Actividad"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                    <!-- Campo de texto para la evolución -->
                    <TextBox Text="{Binding NuevaEvolucionTexto}"
                         Margin="0,20,0,0"
                         AcceptsReturn="True"
                         MinHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="Descripción de la actividad o progreso..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Content="CANCELAR" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" />
                        <Button Command="{Binding GuardarEvolucionCommand}"
                            Content="GUARDAR" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Espacio para la búsqueda -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Espacio para el botón -->
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SearchContainer" 
                    Background="White" CornerRadius="8" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Padding="5,0">
                        <Grid>
                            <materialDesign:PackIcon Kind="Search" Foreground="Gray" VerticalAlignment="Center" Margin="10,0" Width="20" Height="20"/>

                            <TextBox x:Name="SearchBox" 
                     materialDesign:HintAssist.Hint="Buscar Niño, Adolescente o Expediente..."
                     BorderThickness="0"
                     Margin="40,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding BuscarBeneficiarioCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Botón de Acción Circular al lado de la barra -->
                    <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                    Margin="15,0,0,0"
                    Width="40" Height="40"
                    ToolTip="Registrar Nuevo Beneficiario"
                    Command="{Binding NavegarARegistroCommand}">
                        <materialDesign:PackIcon Kind="Plus" Height="24" Width="24" />
                    </Button>

                    <Popup IsOpen="{Binding ResultadosBusqueda.Count, Converter={StaticResource IntToBooleanConverter}, Mode=OneWay}" 
                       StaysOpen="False" 
                       PlacementTarget="{Binding ElementName=SearchContainer}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                        <materialDesign:Card Width="400" MaxHeight="300" Margin="5" materialDesign:ElevationAssist.Elevation="Dp8">
                            <ListBox ItemsSource="{Binding ResultadosBusqueda}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <!-- Reemplazo del PackIcon por la Imagen Circular -->
                                            <Grid Width="35" Height="35" Margin="0,0,12,0">
                                                <!-- Círculo de fondo gris (por si no hay foto) -->
                                                <Ellipse Fill="#E0E0E0"/>
                                                <!-- Icono genérico de fondo -->
                                                <materialDesign:PackIcon Kind="Account" 
                                           Foreground="White" 
                                           Width="20" Height="20" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                                <!-- La foto real recortada en círculo -->
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource BytesToImageConverter}}"
                                                         Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <StackPanel VerticalAlignment="Center">
                                                <!-- TextBlock con Resaltado Dinámico -->
                                                <TextBlock FontSize="14">
                                                    <s:HighlightService.FullText>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Nombres"/>
                                                            <Binding Path="Apellidos"/>
                                                        </MultiBinding>
                                                    </s:HighlightService.FullText>
                                                    <s:HighlightService.HighlightText>
                                                        <Binding Path="DataContext.SearchText" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </s:HighlightService.HighlightText>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Cedula, StringFormat='V-{0}'}" 
                                                   FontSize="11" 
                                                   Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding SeleccionarBeneficiarioCommand}" 
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ListBox>
                        </materialDesign:Card>
                    </Popup>
                </Grid>

                <Border Grid.Row="1" Background="#0b103d" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CONTENEDOR DE LA FOTO -->
                        <Border Grid.Column="0" Width="90" Height="90" CornerRadius="45" 
                            BorderBrush="White" BorderThickness="2" Background="#E0E0E0" 
                            VerticalAlignment="Center">     
                            <Grid>
                                <materialDesign:PackIcon Kind="Account" Foreground="White" Width="50" Height="50" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Button x:Name="BtnFotoBeneficiario"
                                    Command="{Binding SeleccionarFotoCommand}"
                                    Padding="0" Width="86" Height="86"
                                    Background="Transparent" BorderBrush="Transparent"
                                    materialDesign:ButtonAssist.CornerRadius="43"
                                    ToolTip="Click para cambiar foto">

                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Style>

                                    <Button.Content>
                                        <Grid>
                                            <Ellipse Width="86" Height="86">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding BeneficiarioActual.Foto, Converter={StaticResource BytesToImageConverter}}"
                                        Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <Border CornerRadius="43" Background="#AA000000">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnFotoBeneficiario}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="EDITAR" 
                                                     Foreground="White" 
                                                     FontSize="11" 
                                                     FontWeight="Bold" 
                                                     VerticalAlignment="Center" 
                                                     HorizontalAlignment="Center"/> 
                                            </Border>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- INFORMACIÓN DEL BENEFICIARIO -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="White">
                                <Run Text="{Binding BeneficiarioActual.Nombres}" FontWeight="Bold"/>
                                <!--<Run Text=" "/>-->
                                <Run Text="{Binding BeneficiarioActual.Apellidos}"/>
                                </TextBlock>

                                <Button Command="{Binding NavegarAEditarCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="White"
                                    Margin="10,0,0,0"
                                    Padding="4"
                                    Width="35" Height="35"
                                    ToolTip="Editar datos personales">
                                    <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                <TextBlock Text="V-" FontSize="14" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text="{Binding BeneficiarioActual.Cedula}" FontSize="14" Foreground="White" Opacity="0.8" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding BeneficiarioActual.Edad}" FontSize="14" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text=" años" FontSize="14" Foreground="White" Opacity="0.8"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Situación: " FontSize="14" Foreground="White"/>
                                <Border Background="#27AE60" CornerRadius="4" Padding="8,3" Margin="5,0,0,0">
                                    <TextBlock Text="{Binding BeneficiarioActual.Estatus_Legal}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Evolución y Bitácora Cruzada" Style="{StaticResource SeccionHeaderStyle}"/>

                        <!-- Botón para agregar nueva evolución -->
                        <Button Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Center" 
                            Padding="20,0"
                            Height="45"
                            materialDesign:ButtonAssist.CornerRadius="22"
                            Margin="0,10,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AGREGAR NUEVA ACTUALIZACIÓN" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding ListaEvoluciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TimelineItemBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!--<materialDesign:PackIcon Kind="AccountTie" 
                                             Foreground="{Binding ColorArea}" 
                                             Width="18" Height="18"/>-->

                                            <StackPanel Grid.Column="0" Width="60" Margin="0,0,15,0">
                                                <TextBlock Text="{Binding Fecha_Registro, StringFormat=dd MMM}" FontSize="12" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Fecha_Registro, StringFormat=yyyy}" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>

                                                <Grid Margin="0,10,0,0">
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Rectangle Width="2" Fill="#E0E0E0" Height="50" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                </Grid>
                                            </StackPanel>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <materialDesign:PackIcon Kind="CommentTextOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Actividad.Tipo_Actividad}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="10,0"/>
                                                    <TextBlock Text="{Binding Especialista}" FontSize="13" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Text="{Binding Detalle}" FontSize="13" Foreground="#34495E" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Alertas &amp; Archivo" Style="{StaticResource SeccionHeaderStyle}" Margin="0"/>
                                <Separator Background="#F0F0F0" Margin="0,10"/>
                                <TextBlock Text="Alertas Activas: 0" FontSize="14" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Archivo Físico Histórico" Style="{StaticResource SeccionHeaderStyle}" Margin="0"/>
                                <Separator Background="#F0F0F0" Margin="0,10"/>
                                <TextBlock Text="Caja 12, Carpeta D" FontSize="14" Foreground="#34495E" FontWeight="SemiBold"/>
                                <TextBlock Text="(Ubicación: Sede Central)" FontSize="13" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>
    </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>