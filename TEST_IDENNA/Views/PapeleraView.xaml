<UserControl x:Class="TEST_IDENNA.Views.PapeleraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950"
             d:DataContext="{d:DesignInstance Type=vm:PapeleraViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EstiloCabeceraDataGrid" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="EstiloTextoCeldaDataGrid" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            </Style>

            <Style x:Key="CeldaEliminacionStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding CargarPapeleraCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid Background="{DynamicResource FondoPrincipal}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="PAPELERA DE RECICLAJE REPOSITORIO" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}"/>
                <TextBlock Text="Recupere registros eliminados por error o bórrelos definitivamente del sistema." FontSize="13" Foreground="{DynamicResource TextoSecundario}" Margin="0,4,0,0"/>
            </StackPanel>

            <materialDesign:Card Grid.Column="1" 
                                 Background="{DynamicResource FondoErrorSoft}" 
                                 BorderBrush="{DynamicResource BordeErrorSoft}" 
                                 BorderThickness="1" 
                                 Padding="12,8" 
                                 UniformCornerRadius="6"
                                 VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{DynamicResource ColorError}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,-1,8,0"/>
                    <TextBlock Text="El borrado permanente no se puede deshacer." VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextoErrorSoft}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card Grid.Row="1" 
                             Background="{DynamicResource FondoTarjetas}"
                             materialDesign:ElevationAssist.Elevation="Dp2" 
                             UniformCornerRadius="12">

            <TabControl Style="{StaticResource MaterialDesignTabControl}" UseLayoutRounding="True">

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CommentRemoveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="{DynamicResource TextoPrincipal}"/>
                            <TextBlock Text="Evoluciones" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="20">
                        <DataGrid ItemsSource="{Binding ListaEvolucionesPapelera}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" 
                                  ColumnHeaderStyle="{StaticResource EstiloCabeceraDataGrid}"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha Eliminación" Binding="{Binding FechaEliminacion, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" CellStyle="{StaticResource CeldaEliminacionStyle}"/>
                                <DataGridTextColumn Header="Fecha de Evolución" Binding="{Binding Fecha_Registro, StringFormat='dd/MM/yyyy'}" Width="150" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}"/>

                                <DataGridTemplateColumn Header="Nombre de la Actividad" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClipboardTextOutline" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,6,0"/>
                                                <TextBlock Text="{Binding Actividad.Tipo_Actividad}" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center" FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Descripción de la Evolución" Binding="{Binding Detalle}" Width="*" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}"/>

                                <DataGridTemplateColumn Header="Tutor Asociado" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Account" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,6,0"/>
                                                <TextBlock Text="{Binding Especialista.NombreCompleto}" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center" FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.RestaurarEvolucionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Restaurar Registro" Width="32" Height="32" Margin="0,0,8,0">
                                                    <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" Foreground="{DynamicResource ColorExito}"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.EliminarEvolucionPermanenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Eliminar Definitivamente" Width="32" Height="32">
                                                    <materialDesign:PackIcon Kind="DeleteForever" Width="18" Height="18" Foreground="{DynamicResource ColorError}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileRemoveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="{DynamicResource TextoPrincipal}"/>
                            <TextBlock Text="Documentos Adjuntos" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="20">
                        <DataGrid ItemsSource="{Binding ListaDocumentosPapelera}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" 
                                  ColumnHeaderStyle="{StaticResource EstiloCabeceraDataGrid}"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha Eliminación" Binding="{Binding FechaEliminacion, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" CellStyle="{StaticResource CeldaEliminacionStyle}"/>
                                <DataGridTextColumn Header="Fecha de Registro" Binding="{Binding FechaRegistro, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}"/>

                                <DataGridTemplateColumn Header="Archivo" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FileDocument" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,6,0"/>
                                                <TextBlock Text="{Binding NombreArchivo}" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center" FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Beneficiario" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Account" Foreground="{DynamicResource TextoSecundario}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,6,0"/>
                                                <TextBlock Text="{Binding Beneficiario.NombreCompleto}" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center" FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.RestaurarDocumentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Restaurar Documento" Width="32" Height="32" Margin="0,0,8,0">
                                                    <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" Foreground="{DynamicResource ColorExito}"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.EliminarDocumentoPermanenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Eliminar Definitivamente" Width="32" Height="32">
                                                    <materialDesign:PackIcon Kind="DeleteForever" Width="18" Height="18" Foreground="{DynamicResource ColorError}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountRemoveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="{DynamicResource TextoPrincipal}"/>
                            <TextBlock Text="Beneficiarios" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipal}"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="20">
                        <DataGrid ItemsSource="{Binding ListaBeneficiariosPapelera}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" 
                                  ColumnHeaderStyle="{StaticResource EstiloCabeceraDataGrid}"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha Eliminación" Binding="{Binding FechaEliminacion, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" CellStyle="{StaticResource CeldaEliminacionStyle}"/>
                                <DataGridTextColumn Header="Cédula Escolar / Código" Binding="{Binding Cedula}" Width="150" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}"/>
                                <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Edad" Binding="{Binding Edad}" Width="*" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Fecha de Ingreso" Binding="{Binding Fecha_Ingreso, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" ElementStyle="{StaticResource EstiloTextoCeldaDataGrid}"/>

                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.RestaurarBeneficiarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Restaurar Beneficiario" Width="32" Height="32" Margin="0,0,8,0">
                                                    <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" Foreground="{DynamicResource ColorExito}"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                        Command="{Binding DataContext.EliminarBeneficiarioPermanenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" ToolTip="Eliminar Definitivamente" Width="32" Height="32">
                                                    <materialDesign:PackIcon Kind="DeleteForever" Width="18" Height="18" Foreground="{DynamicResource ColorError}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>