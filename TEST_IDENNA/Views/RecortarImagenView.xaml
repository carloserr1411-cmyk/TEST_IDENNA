<Window x:Class="TEST_IDENNA.Views.RecortarImagenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="Recortar Foto" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <!-- Evento añadido -->
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="CanvasRecorte" 
                Grid.Row="0" 
                ClipToBounds="True" 
                Background="Black" 
                MouseWheel="CanvasRecorte_MouseWheel">
                <!-- Imagen centrada -->
                <Image x:Name="ImagenOriginal" Stretch="Uniform" 
                   Width="{Binding ActualWidth, ElementName=CanvasRecorte}"
                   Height="{Binding ActualHeight, ElementName=CanvasRecorte}"/>

                <!-- Selector con valores iniciales -->
                <Canvas x:Name="Selector" Width="200" Height="200" Cursor="SizeAll"
                Canvas.Left="0" Canvas.Top="0"
                MouseLeftButtonDown="Selector_MouseLeftButtonDown"
                MouseMove="Selector_MouseMove"
                MouseLeftButtonUp="Selector_MouseLeftButtonUp">

                    <!-- Usamos Binding para que el círculo siempre mida lo mismo que el Canvas 'Selector' -->
                    <Ellipse Stroke="Cyan" StrokeThickness="3" StrokeDashArray="2 1" 
                 Width="{Binding Width, ElementName=Selector}" 
                 Height="{Binding Height, ElementName=Selector}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Border CornerRadius="1000" Background="White" Opacity="0.1" 
                Width="{Binding Width, ElementName=Selector}" 
                Height="{Binding Height, ElementName=Selector}"/>


                    
                </Canvas>
            </Canvas>

            <!-- Barra Deslizadora (Slider) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <materialDesign:PackIcon Kind="MagnifyPlus" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Slider x:Name="ZoomSlider"
                Orientation="Vertical"
                Height="300"
                Minimum="50"
                Maximum="400"
                Value="200"
                TickFrequency="10"
                IsSnapToTickEnabled="False"
                ValueChanged="ZoomSlider_ValueChanged"/>
                <materialDesign:PackIcon Kind="MagnifyMinus" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

        </Grid>
        <Border Grid.Row="1" Background="#2D2D2D" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCELAR" IsCancel="True" Margin="0,0,10,0" 
                Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                <Button Content="ACEPTAR RECORTE" Click="Aceptar_Click" 
                Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>
            
    </Grid>
</Window>