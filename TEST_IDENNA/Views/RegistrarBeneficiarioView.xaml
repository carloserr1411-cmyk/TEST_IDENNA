<UserControl x:Class="TEST_IDENNA.Views.RegistrarBeneficiarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:RegistroBeneficiarioViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <materialDesign:Card Padding="32" materialDesign:ElevationAssist.Elevation="Dp4" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="30" Height="30" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Registro de Nuevo Ingreso" 
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                   Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBox materialDesign:HintAssist.Hint="Nombres"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding NuevoBeneficiario.Nombres, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,20"/>

                            <TextBox materialDesign:HintAssist.Hint="Apellidos"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding NuevoBeneficiario.Apellidos, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,20"/>

                            <TextBox materialDesign:HintAssist.Hint="Cedula"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding NuevoBeneficiario.Cedula, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,20"/>

                            <DatePicker materialDesign:HintAssist.Hint="Fecha de Nacimiento"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        SelectedDate="{Binding NuevoBeneficiario.Fecha_Nacimiento, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,10"/>
                            <TextBlock Text="Dato requerido para el cálculo de edad" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ComboBox materialDesign:HintAssist.Hint="Estatus Legal"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      Text="{Binding NuevoBeneficiario.Estatus_Legal, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,20">
                                <ComboBoxItem Content="En Proceso de Investigación"/>
                                <ComboBoxItem Content="Bajo Medida de Protección"/>
                                <ComboBoxItem Content="Colocación Familiar"/>
                                <ComboBoxItem Content="Entidad de Atención"/>
                                <ComboBoxItem Content="Situación de Calle"/>
                            </ComboBox>

                            <DatePicker materialDesign:HintAssist.Hint="Fecha de Ingreso al Centro"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        SelectedDate="{Binding NuevoBeneficiario.Fecha_Ingreso, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,20"/>

                            <TextBox materialDesign:HintAssist.Hint="Observaciones Iniciales (Opcional)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding NuevoBeneficiario.Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="80"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"
                                     MaxLength="200"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,30,0,20" Background="#EEEEEE"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCELAR"
                                Command="{Binding CancelarCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Margin="0,0,15,0" 
                                Foreground="Gray"/>

                        <Button Content="REGISTRAR BENEFICIARIO" 
                                Command="{Binding RegistrarCommand}"
                                Width="220" Height="45"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="20"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
