<UserControl x:Class="TEST_IDENNA.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TEST_IDENNA.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Background="{DynamicResource FondoPrincipal}"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ReportesViewModel}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarDatosCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="1.5*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GraficosExpandidos}" Value="True">
                                <Setter Property="Height" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <DatePicker materialDesign:HintAssist.Hint="Desde" Width="150" Margin="0,0,10,0"
            Foreground="{DynamicResource TextoPrincipal}"
            SelectedDate="{Binding FechaDesde, UpdateSourceTrigger=PropertyChanged}"/>

            <DatePicker materialDesign:HintAssist.Hint="Hasta" Width="150" Margin="0,0,10,0"
                        Foreground="{DynamicResource TextoPrincipal}"
                        SelectedDate="{Binding FechaHasta, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Command="{Binding CargarDatosCommand}" Content="FILTRAR" Style="{StaticResource MaterialDesignRaisedButton}"/>

            <Button Command="{Binding ExportarPDFCommand}" Content="GENERAR PDF" Margin="10,0,0,0" 
                    Background="{DynamicResource ColorExito}" 
                    BorderBrush="{DynamicResource ColorExito}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3">
            <materialDesign:Card Margin="5" Background="{DynamicResource ColorTarjetaOscura}" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CASOS ACTIVOS" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalActivos}" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="5" Background="{DynamicResource ColorExito}" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EGRESOS TOTALES" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalEgresados}" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="5" Background="{DynamicResource FondoTarjetas}" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Beneficiarios cuyo estatus legal es: Pendiente" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextoSecundario}" FontWeight="SemiBold"/>
                    <TextBlock Text="PENDIENTES" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextoSecundario}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalPendientes}" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Margin="5" Padding="12" Background="{DynamicResource FondoTarjetas}" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Distribución por Estatus Legal" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,0,0,10"/>
                    <lvc:PieChart Grid.Row="1" Series="{Binding SeriesEstatus}" Background="Transparent"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Margin="5" Padding="12" Background="{DynamicResource FondoTarjetas}" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ingresos Mensuales" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}" Margin="0,0,0,10"/>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesMensual}" XAxes="{Binding XAxes}" Background="Transparent"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <ToggleButton Grid.Row="3" 
                      IsChecked="{Binding GraficosExpandidos}"
                      HorizontalAlignment="Center" 
                      Margin="0">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
                    <Setter Property="Content" Value="✨ EXPANDIR GRÁFICOS ↗" />
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Content" Value="📉 RECOGER GRÁFICOS ↙" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>

        <Border Grid.Row="4" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GraficosExpandidos}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <materialDesign:Card Margin="5" Background="{DynamicResource FondoTarjetas}" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <DataGrid ItemsSource="{Binding ArchivoHistoricoCompuesto}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          Background="{DynamicResource FondoTarjetas}"
                          HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Beneficiario" Binding="{Binding Nombre}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Fecha Egreso" Binding="{Binding Fecha_Egreso, StringFormat=d}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo_Egreso}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>