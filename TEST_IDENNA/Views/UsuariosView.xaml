<UserControl x:Class="TEST_IDENNA.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodels="clr-namespace:TEST_IDENNA.ViewModels"
             xmlns:helpers="clr-namespace:TEST_IDENNA.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:UsuariosViewModel}"
             Background="{DynamicResource FondoPrincipal}"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <helpers:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarUsuariosCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" DialogTheme="Inherit" Identifier="UsuariosHost">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="{DynamicResource FondoTarjetas}" Padding="30" CornerRadius="12" Width="450">
                <StackPanel>
                    <TextBlock Text="{Binding TituloDialogo}" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource TextoPrincipal}" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding EditNombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{DynamicResource TextoPrincipal}"
                         materialDesign:HintAssist.Hint="Nombre y Apellido del Funcionario"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding EditNombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{DynamicResource TextoPrincipal}"
                             materialDesign:HintAssist.Hint="ID de Usuario" Margin="0,0,10,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                        <PasswordBox Grid.Column="1" x:Name="PassBox" 
                                     Foreground="{DynamicResource TextoPrincipal}"
                                 materialDesign:HintAssist.Hint="Nueva Contraseña"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 ToolTip="Dejar en blanco para no modificar">
                        </PasswordBox>
                    </Grid>

                    <ComboBox ItemsSource="{Binding RolesDisponibles}" 
                              Foreground="{DynamicResource TextoPrincipal}"
                          SelectedItem="{Binding EditRol}"
                          materialDesign:HintAssist.Hint="Rol Institucional / Permisos"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="Estado de la Cuenta:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource TextoSecundario}"/>
                        <ToggleButton IsChecked="{Binding EditActivo}" Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <TextBlock Text="{Binding EditActivo, Converter={StaticResource BooleanToStatusConverter}}" 
                                   Foreground="{DynamicResource TextoPrincipal}"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCELAR" Command="{Binding CancelarCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>

                        <Button Content="GUARDAR CAMBIOS" Command="{Binding GuardarUsuarioCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            CommandParameter="{Binding ElementName=PassBox}"
                            Background="{DynamicResource PrimaryHueMidBrush}" Foreground="{DynamicResource TextoPrincipal}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>
        
        <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountKeyOutline" Width="32" Height="32" Foreground="{DynamicResource TextoPrincipal}" VerticalAlignment="Center"/>
                    <TextBlock Text="CONTROL DE PERSONAL Y ACCESOS" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextoPrincipal}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Administración de cuentas de usuario, asignación de roles institucionales y estados de actividad." FontSize="14" Foreground="{DynamicResource TextoSecundario}" Margin="44,4,0,0"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding AbrirFormularioCrearCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="REGISTRAR USUARIO" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>

        <materialDesign:Card Grid.Row="1" Background="{DynamicResource FondoTarjetas}" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding PersonalSistema}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}" Background="Transparent" HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Funcionario / Especialista" Binding="{Binding NombreCompleto}" Width="2.5*" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Usuario ID" Binding="{Binding NombreUsuario}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Rol / Nivel de Acceso" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:Chip Content="{Binding Rol}" Height="24" FontSize="11" FontWeight="SemiBold">
                                    <materialDesign:Chip.Style>
                                        <Style TargetType="materialDesign:Chip">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rol}" Value="Administrador">
                                                    <Setter Property="Background" Value="#22ef4444"/>
                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rol}" Value="UsuarioComun">
                                                        <Setter Property="Background" Value="#223b82f6"/>
                                                        <Setter Property="Foreground" Value="#3b82f6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                        </Style>
                                    </materialDesign:Chip.Style>
                                </materialDesign:Chip>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Estado" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter Property="Fill" Value="#22c55e"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Fill" Value="#ef4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Activo, Converter={StaticResource BooleanToStatusConverter}, FallbackValue='Desconocido'}" Foreground="{DynamicResource TextoPrincipal}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30"
                                            Command="{Binding DataContext.AbrirFormularioEditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" ToolTip="Editar Datos">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="{DynamicResource WarningActionBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30"
                                            Command="{Binding DataContext.AlternarEstadoUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" ToolTip="Activar/Desactivar">
                                        <materialDesign:PackIcon Kind="Power" Width="16" Height="16" Foreground="#ef4444"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>